# observe: 仅发现机会；paper: 真实行情模拟成交；live: 真实订单
MODE=paper
EXCHANGES=gate,hyperliquid
# 留空无效；* 订阅全部共同标的的轻量行情，深度按需订阅
SYMBOLS=BTC,ETH
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0
# 同一资金账户的所有进程/实例必须使用相同命名空间
NAMESPACE=pyspreadbot
CACHE_DIR=data/contracts

# 每单位报价币的 USD 估值，必须按实际汇率自行配置；运行中固定，修改后重启
USDT_USD=1
USDC_USD=1
# 单腿最大下单名义金额，统一 USD 估值
MAX_NOTIONAL=50
MAX_POSITIONS=3
ENTRY_BPS=20
# 按 EXCHANGES 固定顺序：第一个所 / 第二个所的长期溢价中枢
MIDLINE_BPS=0
SLIPPAGE_BPS=5
EXIT_PROFIT=0.1
STOP_LOSS=2
TAKE_FRACTION=0.2
MAX_AGE=2
SIGNAL_SECONDS=0.3
REQUEST_TIMEOUT=5
# HTTP 与 WSS 分别配置；None 或留空表示直连，WSS 不继承 HTTP_PROXY
# 代理地址示例：http://127.0.0.1:7890（WSS 也填写 HTTP 代理地址）
HTTP_PROXY=None
WSS_PROXY=None
RECONCILE_SECONDS=5
METADATA_SECONDS=3600
MAX_DEPTH_SUBSCRIPTIONS=20
ORDERS_PER_MINUTE=30
# 比率而非 bps；应填写账户实际 taker 费率，用于费用估计和开仓门槛
GATE_FEE=0.0005
HL_FEE=0.00045

# 显式单位映射，未映射的数字前缀不会自动剥离；下例仅展示格式
# ALIASES={"gate:1000PEPE_USDT":["PEPE","1000"]}
ALIASES={}

# 仅 live 必需；Gate 要求单向持仓模式，HL_ACCOUNT 为主账户地址，HL_KEY 可为 agent 私钥
GATE_KEY=
GATE_SECRET=
HL_KEY=
HL_ACCOUNT=

# HIP-3 部署方市场；逗号分隔，* 自动发现全部，留空仅原生永续
HL_DEXS=xyz,para,io,mkts
# 观察/模拟的估算费率；实盘必须在 HL_DEX_FEES 中显式设置对应 DEX
HL_HIP3_FEE=0.001
# 填账户实际 taker 费率，例如 {"xyz":"0.0009"}；示例不是实时费率
HL_DEX_FEES={}
# 其他抵押/手续费币种到 USD 的固定折算率，例如 {"USDH":"0.999"}
QUOTE_USD_RATES={}
# HIP-3 自动去掉 DEX 前缀匹配；特殊单位或不同资产使用 ALIASES 覆盖：
# ALIASES={"hyperliquid:xyz:TSLA":["TSLA","1"]}
